# Internal gateway with Supabase-style paths for the edge functions and pg_net (http://asterra-gateway:8000).
# Not published on the host: public traffic arrives through the VPS's Traefik (see docker-compose.yml labels).
{
	admin off
	auto_https off
}

:8000 {
	handle_path /rest/v1/* {
		reverse_proxy rest:3000
	}
	handle_path /functions/v1/* {
		reverse_proxy functions:9000
	}
	respond 404
}
