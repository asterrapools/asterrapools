# infra/.env on the VPS (chmod 600). Generate the secrets with: node ../scripts/vps-secrets.mjs
POSTGRES_PASSWORD=
JWT_SECRET=
SERVICE_ROLE_KEY=
INDEXER_TOKEN=
ACME_EMAIL=
TESTNET_DOMAIN=testnet.asterrapools.tech
MAINNET_DOMAIN=asterrapools.tech
# apex upstream: the testnet app until the mainnet release, then web-mainnet:3000
APEX_UPSTREAM=web-testnet:3000
# modules switched on in the API (comma list): launchpad,credit,buyback
FEATURES=
