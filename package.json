{
  "name": "asterrapools",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": { "node": ">=22.19" },
  "scripts": {
    "dev": "turbo run dev --filter=@asterrapools/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "contracts:test": "cd packages/contracts && forge test",
    "local:chain": "bash scripts/local-chain.sh",
    "local:deploy": "bash scripts/local-deploy.sh",
    "testnet:verify": "bash scripts/verify-contracts.sh testnet",
    "mainnet:verify": "bash scripts/verify-contracts.sh mainnet"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.3"
  }
}
